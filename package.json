{
  "name": "meetsum",
  "version": "1.0.0",
  "description": "MeetSum - Nhận diện người nói, bóc băng và tóm tắt cuộc họp từ video, chạy hoàn toàn trên máy cá nhân",
  "main": "./out/main/index.js",
  "author": "MaiMoney",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "build": "electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "build:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml",
    "build:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "release:win": "electron-vite build && electron-builder --win --config electron-builder.yml --publish always",
    "release:mac": "electron-vite build && electron-builder --mac --config electron-builder.yml --publish always",
    "build:win:signed": "electron-vite build && electron-builder --win --config electron-builder.yml -c.win.signAndEditExecutable=true",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "docx": "^9.7.1",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "lucide-react": "^0.468.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nhQing/meet-sum.git"
  }
}
